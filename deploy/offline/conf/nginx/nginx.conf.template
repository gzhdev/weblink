worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml image/svg+xml;
    gzip_min_length 256;
    gzip_comp_level 5;

    # HTTP 统一跳转 HTTPS（HTTPS_PORT 不是 443 时，按实际端口修改此处）
    server {
        listen 80;
        server_name _;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name _;

        ssl_certificate     /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;

        root /usr/share/nginx/html;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        # 入口与 PWA 文件不缓存，升级后客户端能拿到新版本
        location ~* ^/(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest|version\.json)$ {
            add_header Cache-Control "no-cache";
            try_files $uri =404;
        }

        # 带 hash 的静态资源长期缓存
        location /assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        # 信令 WebSocket
        location /ws {
            proxy_pass http://ws-server:9000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # 临时 TURN 凭据接口；内网未配置云端 TURN 时返回 503，前端回落到内置的 STUN/TURN
        location = /turn-credentials {
            proxy_pass http://ws-server:9000;
            proxy_set_header Host $host;
        }
    }
}
